{
  "name": "browser-extension",
  "version": "1.1.4",
  "description": "A browser extension that provides web_search and web_fetch capabilities for in-browser Agents",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:store": "CW_CODEX_OAUTH=0 wxt build",
    "zip:store": "CW_CODEX_OAUTH=0 wxt zip",
    "build:firefox": "wxt build -b firefox",
    "watch": "wxt build --watch",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@creatorweave/shared": "workspace:*",
    "@mcp-b/webmcp-polyfill": "4.0.0",
    "@mozilla/readability": "^0.5.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.5",
    "wxt": "^0.19.0"
  },
  "keywords": [
    "chrome-extension",
    "agent",
    "web-search",
    "web-fetch"
  ],
  "license": "MIT"
}
