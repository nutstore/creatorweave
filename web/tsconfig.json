{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Web Application",
  "extends": "@creatorweave/config/tsconfig/react",
  "compilerOptions": {
    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@wasm/*": ["./public/wasm/*"]
    },

    /* WASM support */
    "types": ["@types/react", "@types/react-dom"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["src", "app", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "vite.config.ts", "vite-plugin-*.ts"]
}
